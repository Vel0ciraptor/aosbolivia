# RepuestoIA API — Variables de Entorno

# Base de Datos
DATABASE_URL="postgresql://repuestoia:repuestoia_secret@localhost:5432/repuestoia_dev?schema=public"

# JWT
JWT_SECRET="repuestoia_super_secret_jwt_key_2024_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="repuestoia_refresh_secret_key_2024_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3003

# Google OAuth (opcional en demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
